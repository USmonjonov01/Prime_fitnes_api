NODE_ENV=development
PORT=4000

# Neon: Dashboard -> Connect. Ikkita manzil kerak:
# 1) POOLED (host ichida "-pooler" bor) -> DATABASE_URL
# 2) DIRECT ("-pooler"siz)               -> DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Frontend manzillari, vergul bilan (oxirida "/" bo'lmasin)
CORS_ORIGINS=http://localhost:5173

# Faqat birinchi marta: npm run db:seed zal egasini shu ma'lumot bilan yaratadi
SEED_OWNER_NAME=Zal egasi
SEED_OWNER_PHONE=+998901234567
SEED_OWNER_PASSWORD=

# Telefon raqamini SMS kod bilan tasdiqlash.
# console: SMS yuborilmaydi, kod server konsoliga yoziladi (lokal sinov). Productionda ishlamaydi.
# eskiz: haqiqiy SMS (Eskiz.uz kabineti: email, parol, jo'natuvchi). Productionda shuni qo'ying.
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Eskiz productionda faqat o'zi tasdiqlagan matn shablonlarini o'tkazadi. {code} kod o'rniga qo'yiladi.
SMS_TEMPLATE="Gym Prime Fit: tasdiqlash kodi {code}. Uni hech kimga bermang."
SMS_DAILY_LIMIT=200